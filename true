body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background: radial-gradient( circle at 50% 0%, #252b3d 0%, #111522 50%, #060811 100% );
  font-family: Arial, sans-serif;
}
.calculator {
  position: relative;
  width: 400px;
  height: 600px;
  padding: 20px;
  border-radius: 30px;
  background: linear-gradient( 145deg, #5804075a, #0307417d );
  border: 1px solid rgba(255, 255, 255, 0.25);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.15);
  overflow: hidden;
}
.calculator > .header {
  margin-bottom: 5px !important;
  margin-bottom: 0 !important;
}
.calculator h1 {
  color: rgb(222, 251, 2) !important;
  margin-bottom: 0 !important;
}
.calculator h1 + p {
  color: rgba(6, 240, 221, 0.55) !important;
  margin-bottom: 20px !important;
}
.icon {
  color: #abc708;
  border: 1px solid rgba(255, 255, 255, 0.18);
  width: 50px;
  font-size: 25px;
  border-radius: 50%;
  text-align: center;
  margin-bottom: 0 !important;
}
.display {
  height: 105px;
  padding: 15px !important;
  margin-bottom: 12px !important;
  border-radius: 22px !important;
  background: linear-gradient( 145deg, #303542, #292d3a ) !important;
  border: 1px solid rgba(255, 255, 255, 0.22) !important;
  box-shadow: inset 0 5px 15px rgba(0, 0, 0, 0.18), 0 6px 15px rgba(0, 0, 0, 0.12);
}
#previousDisplay {
  color: rgba(20, 210, 166, 0.604) !important;
  font-size: 14px;
  height: 20px;
  text-align: right !important;
}
#currentDisplay {
  color: #56bb09 !important;
  font-size: 36px !important;
  font-weight: 400 !important;
  line-height: 1;
  margin-top: 5px !important;
  text-align: right !important;
}
.small-line {
  background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.18), transparent );
}
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(5, 1fr);
  gap: 8px !important;
  height: 272px;
}
#zero {
  grid-column: span 2;
}
.grid button {
  height: 48px;
  min-width: 0;
  border-radius: 17px !important;
  border: 1px solid rgba(255, 255, 255, 0.18) !important;
  font-size: 19px;
  font-weight: 700;
  color: #ffffff;
  cursor: pointer;
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.12), 0 5px 10px rgba(0, 0, 0, 0.15);
  transition: transform 0.12s ease, filter 0.15s ease;
}
.grid button:hover {
  filter: brightness(1.08);
}
.grid button:active {
  transform: scale(0.94);
}
.number {
  background: linear-gradient( 145deg, #d70e4a, #0a0a01 ) !important;
}
.number:hover {
  background: linear-gradient( 145deg, #094c3b, #09387a ) !important;
}
.clear, .action, .percentage {
  background: linear-gradient( 145deg, #9c3ca6, #08ad65 ) !important;
}
.clear:hover, .action:hover, .percentage:hover {
  background: linear-gradient( 145deg, #9c3ca6, #08ad65 ) !important;
}
.operator {
  background: linear-gradient( 145deg, #ff6a42, #9d290c ) !important;
  border-color: rgba(255, 140, 110, 0.4) !important;
  color: white !important;
  box-shadow: 0 6px 15px rgba(255, 80, 40, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.18);
}
.operator:hover {
  background: linear-gradient( 145deg, #ff7952, #ff6240 ) !important;
}
.equal {
  background: linear-gradient( 145deg, #2599e8, #1688d8 ) !important;
  border-color: rgba(90, 180, 255, 0.45) !important;
  color: white !important;
  box-shadow: 0 6px 15px rgba(20, 140, 225, 0.22), inset 0 1px 1px rgba(255, 255, 255, 0.18);
}
.equal:hover {
  background: linear-gradient( 145deg, #35a4ed, #2094df ) !important;
}
.calculator > p:last-child {
  margin-top: 20px !important;
  margin-bottom: 20px !important;
  margin-left: 100px !important;
  color: rgb(222, 251, 2) !important;
  font-size: 16px !important;
  line-height: 18px;
}
@media (max-width: 430px) {
  .calculator {
    width: 100%;
    max-width: 400px;
    height: 600px;
    padding: 18px;
  }
}
